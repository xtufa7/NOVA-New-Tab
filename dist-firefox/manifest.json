{
  "manifest_version": 3,
  "name": "NØVA — New Tab",
  "short_name": "NØVA",
  "version": "3.0.0",
  "description": "Local-first New Tab, smart website themes, inspector, tab manager and command palette.",
  "author": "xtufa7 · https://github.com/xtufa7",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_page": "settings.html",
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "NØVA · Browser suite",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "declarativeNetRequest",
    "scripting",
    "alarms"
  ],
  "optional_permissions": [
    "tabs",
    "history",
    "nativeMessaging",
    "sessions"
  ],
  "commands": {
    "open-control-center": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Open NØVA control center"
    },
    "float-live": {
      "suggested_key": {
        "default": "Ctrl+Shift+F"
      },
      "description": "Pin current tab preview above applications"
    },
    "float-interactive": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Move current tab into an interactive window"
    },
    "float-close": {
      "suggested_key": {
        "default": "Ctrl+Shift+X"
      },
      "description": "Close preview / restore interactive tab"
    },
    "open-command-palette": {
      "description": "Open NØVA command palette"
    },
    "open-tab-manager": {
      "description": "Open NØVA Tab Manager"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://lrclib.net https://guns.lol https://*.guns.lol; img-src 'self' data: blob: https:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' blob:"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://lrclib.net/*"
  ],
  "sidebar_action": {
    "default_title": "NØVA Tabs",
    "default_panel": "manager.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nova@xtufa7",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}